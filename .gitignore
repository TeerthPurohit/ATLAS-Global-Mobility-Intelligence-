# ── Data ────────────────────────────────────────────
data/raw/*
data/warehouse/*
!data/warehouse/.gitkeep
!data/raw/.gitkeep

# ── DuckDB ──────────────────────────────────────────
*.duckdb
*.duckdb.wal
*.db
# deployed.duckdb is a build output of scripts/build_deployed_duckdb.py, not a
# source file. It was previously un-ignored here, but it measures ~212MB --
# past GitHub's hard 100MB per-file limit, so committing it fails the push.
# It is rebuilt from the warehouse and shipped to the deploy host out of band
# (see docs/deployment/README.md).

# ── Streaming-training resume state (transient, regenerate locally) ──
_streaming_checkpoint.json

# ── dbt ─────────────────────────────────────────────
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ── Jupyter ─────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── ML Model Artifacts ─────────────────────────────
*.pkl
*.pt
*.joblib
!models/xgboost_model/.gitkeep
!models/lstm_model/.gitkeep
models/query_plan_finetune/adapter/*.safetensors
models/query_plan_finetune/gguf/*.gguf
models/query_plan_finetune/merged/

# ── IDE / OS ────────────────────────────────────────
.claude/
.agents/
.cursor/
.codex/
.superpowers/
.impeccable/
.vscode/
.idea/

# ── AI tooling output (not project code) ───────────
graphify-out/
skill-observations/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.env

# ── Local logs ─────────────────────────────────────
logs/

# ── Node / Frontend ────────────────────────────────
node_modules/
frontend/dist/
frontend/.next/
frontend/*.tsbuildinfo
frontend/dev.log

# ── Docker ──────────────────────────────────────────
.docker/
.docker-tmp-config/
site

# ── Python caches / test artifacts ─────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
pip-wheel-metadata/

# ── dotenv variations (local overrides) ──────────────────────────────
.env.local
.env.*

# ── Node/npm logs ───────────────────────────────────────────────────
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE / editor extras
*.iml
.ropeproject/

# Impeccable's local session cache -- absolute machine-local file paths,
# not project config (unlike the tracked .impeccable/config.json).
**/.impeccable/hook.cache.json


# CDK synth output -- build artifact, never source
infra/cdk/cdk.out/

# graphify extraction cache -- version-keyed build artifact, re-churns on every
# graphify upgrade. The graph itself (graph.json/html, GRAPH_REPORT.md) is tracked.
graphify-out/cache/
kaggle.json

# ── Local databases / generated deployment state ────────────────
data/*.db
data/*.db.wal
data/warehouse/dataset-metadata.json
