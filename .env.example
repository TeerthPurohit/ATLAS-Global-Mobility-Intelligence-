# ── DuckDB ──────────────────────────────────────────
# ── DuckDB ──────────────────────────────────────────
DUCKDB_PATH=data/warehouse/nyc_rides.duckdb
OSRM_URL=https://router.project-osrm.org

# ── Geographic discovery (GeoNames, backend-only, never sent to frontend) ──
GEONAMES_USERNAME=
GEONAMES_PASSWORD=

# ── Langfuse LLM tracing (optional -- rag/tracing.py no-ops if unset) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=  # defaults to "development"; set "production" on the deployed backend

# ── Postgres (RDS, operational store — prediction_log/session_store) ──
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLROOTCERT=certs/global-bundle.pem
# Production deployments must use Neon's pooled ("-pooler") connection
# string, not the direct one -- rag/db.py's engine bounds its own pool to
# pool_size=3/max_overflow=2, but that's still per-process; without the
# pooled endpoint, multiple deployment processes can still exceed Neon
# free tier's connection cap under load.
DATABASE_URL=

# ── Auth (backend/services/auth_service.py) ──────────
# Session cookie requires TLS -- keep false for local http:// dev, true in production.
COOKIE_SECURE=false

# ── Backend ─────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000
# Comma-separated browser origins allowed to call the API. Unset = the local
# dev ports in backend/main.py's DEFAULT_CORS_ORIGINS. Set this in production
# to the deployed frontend origin -- it REPLACES the localhost defaults, and
# "*" is not usable because the session cookie needs allow_credentials.
CORS_ORIGINS=

# ── Qdrant Cloud ────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Frontend ────────────────────────────────────────
# The browser never talks to the backend directly -- frontend-web/next.config.js
# proxies /api/* to it server-side. Set BACKEND_URL in frontend-web/.env.local
# (Next.js doesn't read this repo-root .env), not here.
