# ── DuckDB ──────────────────────────────────────────
# ── DuckDB ──────────────────────────────────────────
DUCKDB_PATH=data/warehouse/nyc_rides.duckdb
OSRM_URL=https://router.project-osrm.org

# ── Geographic discovery (GeoNames, backend-only, never sent to frontend) ──
GEONAMES_USERNAME=
GEONAMES_PASSWORD=

# ── Langfuse LLM tracing (optional -- rag/tracing.py no-ops if unset) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Postgres (RDS, operational store — prediction_log/session_store) ──
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLROOTCERT=certs/global-bundle.pem
DATABASE_URL=

# ── Auth (backend/services/auth_service.py) ──────────
# Session cookie requires TLS -- keep false for local http:// dev, true in production.
COOKIE_SECURE=false

# ── Backend ─────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000

# ── Qdrant Cloud ────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Frontend ────────────────────────────────────────
# The browser never talks to the backend directly -- frontend-web/next.config.js
# proxies /api/* to it server-side. Set BACKEND_URL in frontend-web/.env.local
# (Next.js doesn't read this repo-root .env), not here.
